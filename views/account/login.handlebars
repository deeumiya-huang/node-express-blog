<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/public/css/site.css">
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<div class="main-container">
    <div class="login-image">
        <img src="/public/assets/sky2.jpg" alt="Login Image">
    </div>

    <div class="form-container">
        <div class="form-wrapper">
            <h2>Sign In</h2>
            <p class="subtitle">Please enter your username and password</p>

            <form action="#" method="POST">
                <div class="input-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" placeholder="please enter username" required>
                </div>

                <div class="input-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" placeholder="please enter password" required>
                </div>

                <button type="submit" class="login-btn">Sign In</button>
            </form>

            <div class="form-footer">
                <p>Don't have an account? <a href="">Sign up now</a></p>
            </div>
        </div>
    </div>
</div>
</body>
</html>