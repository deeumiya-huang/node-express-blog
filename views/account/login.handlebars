{{#if failMessage}}
    <p class="msg-error" id="server-msg">{{failMessage}}</p>
{{/if}}
{{#if successMessage}}
    <p class="msg-success" id="server-msg">{{successMessage}}</p>
{{/if}}

<h2>Sign In</h2>
<p class="subtitle">Please enter your username and password</p>

<form action="/account/login" method="POST">
    <div class="input-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="please enter username" required>
    </div>

    <div class="input-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="please enter password" required>
    </div>

    <button type="submit" class="submit-btn">Sign In</button>
</form>

<div class="form-footer">
    <p>Don't have an account? <a href="/account/create">Sign up now</a></p>
</div>
