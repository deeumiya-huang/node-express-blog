<!-- post modal(default: hidden) -->
<div id="postModal" class="modal-overlay">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Create Post</h3>
            <button id="closePostBtn" class="close-btn">&times;</button>
        </div>

        <form id="postForm" action="/createPost" method="POST" enctype="multipart/form-data">

            <div class="form-row">
                <div class="form-group flex-1">
                    <label for="category">Select Category</label>
                    <select id="category" name="category" required>
                        <option value="" disabled selected>Please select...</option>
                        <option value="mood">Mood</option>
                        <option value="life">Daily Life</option>
                        <option value="tech">Technology</option>
                        <option value="economy">Economy</option>
                    </select>
                </div>

                <div class="form-group flex-2">
                    <label for="title">Post Title</label>
                    <input type="text" id="title" name="title" placeholder="Enter title here..." required>
                </div>
            </div>

            <div class="form-group">
                <label>Content</label>
                <div id="quill-editor"></div>
                <input type="hidden" id="content" name="content">
            </div>

            <div class="form-group">
                <label for="postImage" class="file-upload-label">Upload Photo</label>
                <input type="file" id="postImage" name="postImage" accept="image/jpeg, image/png, image/gif, .jpg, .jpeg, .png, .gif" class="file-input">
                <div id="imagePreview" class="image-preview"></div>
            </div>

            <div class="modal-footer">
                <button type="button" id="cancelBtn" class="btn-secondary-outline">Cancel</button>
                <button type="submit" class="btn-primary">Publish</button>
            </div>
        </form>
    </div>
</div>

<main class="main-container">

    <!-- Sorting Filter Section -->
    <div class="filter-section">
        <label for="sort-select">Sort by: </label>
        <select id="sort-select" class="sort-dropdown">
            <option value="latest">Latest</option>
            <option value="category">Category</option>
            <option value="username">Username</option>
            <option value="title">Title</option>
        </select>
    </div>

    <!-- Post List -->
    <section class="post-list">

        {{#each posts}}
            <article class="post-card"
                     data-latest="{{this.post_at}}"
                     data-category="{{this.category}}"
                     data-username="{{this.username}}"
                     data-title="{{this.title}}">
                <div class="post-user">
                    <div class="avatar">
                        <img src="/public/assets/avatar/{{this.avatar}}" alt="Avatar">
                    </div>
                    <div class="user-meta">
                        <span class="post-author">{{this.username}}</span>
                        <span class="post-time">{{this.post_at}}</span>
                    </div>
                </div>

                <div class="post-body">
                    <span class="post-category">{{this.category}}</span>
                    <h2 class="post-title">{{this.title}}</h2>
                    <div class="post-content">{{{this.content}}}</div>
                </div>

                {{#if this.img_name}}
                    <div class="post-image">
                        <a href="/public/assets/post-img/{{this.img_name}}">
                            <img src="/public/assets/post-thumbnail/{{this.img_name}}" alt="Post Image">
                        </a>
                    </div>
                {{/if}}
                <div class="post-actions">
                    <button class="action-btn" title="Like">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
                        <span>{{this.likes}}</span>
                    </button>
                    <button  class="action-btn comment-link" data-post-id="{{this.id}}" title="Comment">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        <span>{{this.comment}}</span>
                    </button>
                </div>
                <div class="post-comments-container">
                    {{#if @root.user}}
                        <form action="/article/{{this.id}}/comment/create" method="POST" class="main-comment-form">
                            <img src="/public/assets/avatar/{{@root.user.profile.avatar}}" alt="User Avatar" class="user-avatar-sm">
                            <span class="comment-username">{{@root.user.username}}</span>
                            <input type="text" name="content" placeholder="leave a comment for this post..." required>
                            <button type="submit">publish</button>
                        </form>
                    {{/if}}

                    <div class="comments-list">
                        {{#if comments}}
                            {{#each comments}}
                                {{>comment data=this postId=../id}}
                            {{/each}}
                        {{/if}}
                    </div>
                </div>
            </article>
        {{/each}}

        <!-- Card Example -->
        <article class="post-card">
            <div class="post-user">
                <div class="avatar">
                    <img src="/public/assets/avatar/avatar1.png" alt="Avatar">
                </div>
                <div class="user-meta">
                    <span class="post-author">Harry</span>
                    <span class="post-time">3 hrs ago</span>
                </div>
            </div>

            <div class="post-body">
                <span class="post-category">Web Development</span>
                <h2 class="post-title">The Art of Minimalism in Modern Web Design</h2>
                <p class="post-content">Less is more. In this article, we dive deep into how negative space, soft color palettes, and clean typography can elevate user experience...</p>
            </div>

            <div class="post-image">
                <img src="/public/assets/sky1.jpg" alt="Post Image">
            </div>

            <div class="post-actions">
                <button class="action-btn" title="Like">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
                    <span>1</span>
                </button>
                <button class="action-btn" title="Comment">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    <span>1</span>
                </button>
            </div>
        </article>

    </section>
</main>

